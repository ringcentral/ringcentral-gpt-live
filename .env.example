# Required. Create/select a project in the OpenAI API dashboard.
OPENAI_PROJECT_ID=proj_replace_me
OPENAI_API_KEY=sk-proj-replace_me

# Required. Use the same private random token in the caller and webhook server.
# Example PowerShell generator:
# [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(16)).ToLower()
SIP_CALL_TOKEN=

# Required by the webhook server. Copy this when you create the webhook.
OPENAI_WEBHOOK_SECRET=whsec_replace_me

# Optional settings.
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_BACKEND_MODEL=gpt-6-luna
OPENAI_VOICE=marin
# Optional override for the GPT-Live voice prompt. The built-in default is the Stridewell agent.
# LIVE_AGENT_INSTRUCTIONS=
PORT=3000
CALL_DURATION_SECONDS=15
PCMU_AUDIO_FILE=audio/hello_tell_me_a_joke.ul
# Advertise Opus before PCMU in SDP. Opus media is not implemented by this demo.
PREFER_OPUS=false
RECORD_INCOMING_AUDIO=false
INCOMING_AUDIO_FILE=output/recording-<date>.ul
# Optional raw protocol tracing. Keep disabled unless actively debugging.
LOG_SIP_MESSAGES=false
LOG_WEBSOCKET_MESSAGES=false

# Optional RTP/SIP overrides. The defaults are normally correct.
# Set RTP_ADVERTISED_IP to a public/forwarded address only if you configured it.
# RTP_ADVERTISED_IP=203.0.113.10
# RTP_PORT=40000 # Must be even.
# SIP_HOST=sip.api.openai.com
# SIP_PORT=5061
