# =============================================================================
# REQUIRED — edit these four values, then you're ready to run.
# =============================================================================

# OpenAI project ID (Settings → Project → General). Looks like proj_...
OPENAI_PROJECT_ID=proj_replace_me

# API key from the SAME project (Settings → Project → API Keys). Looks like sk-proj-...
OPENAI_API_KEY=sk-proj-replace_me

# Private random token shared by the caller and the webhook server.
# Must be 16-64 letters, digits, underscores, or hyphens.
# Generate one:
#   macOS / Linux:  openssl rand -hex 16
#   PowerShell:     [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(16)).ToLower()
SIP_CALL_TOKEN=replace_me_with_generated_token

# Webhook signing secret. Copy it when you create the webhook. Looks like whsec_...
OPENAI_WEBHOOK_SECRET=whsec_replace_me


# =============================================================================
# OPTIONAL — everything below has working defaults. Leave as-is to get started.
# =============================================================================

# --- Model and voice ---
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_BACKEND_MODEL=gpt-6-luna
OPENAI_VOICE=marin
# Override the GPT-Live voice prompt. The built-in default is the Stridewell agent.
# LIVE_AGENT_INSTRUCTIONS=

# --- Server and test caller ---
PORT=3000
CALL_DURATION_SECONDS=15
PCMU_AUDIO_FILE=audio/hello_tell_me_a_joke.ul
# Advertise Opus before PCMU in SDP. Opus media is not implemented by this demo.
PREFER_OPUS=false
RECORD_INCOMING_AUDIO=false
INCOMING_AUDIO_FILE=output/recording-<date>.ul

# --- Debug logging (keep disabled unless actively debugging) ---
LOG_SIP_MESSAGES=false
LOG_WEBSOCKET_MESSAGES=false
# Print each verified webhook event (e.g. live.transport.incoming) as JSON.
LOG_WEBHOOK_EVENTS=false

# --- RTP/SIP overrides (defaults are normally correct) ---
# Set RTP_ADVERTISED_IP to a public/forwarded address only if you configured it.
# RTP_ADVERTISED_IP=203.0.113.10
# RTP_PORT=40000 # Must be even.
# SIP_HOST=sip.api.openai.com
# SIP_PORT=5061
